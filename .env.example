# Universo IA - Arquivo de Exemplo de Configuração de Ambiente (.env)

# Porta do servidor web FastAPI (padrão: 8765)
PORT=8765

# Endereço e porta do servidor local do modelo LLM (llama.cpp)
MODEL_URL=http://127.0.0.1:8081

# Host de escuta da aplicação web
HOST=127.0.0.1

# Quantidade de threads de CPU alocadas para a inferência local (padrão: 2 para equilíbrio com Three.js)
MODEL_THREADS=2

# Limite máximo de contexto da janela de atenção (tokens)
MAX_CONTEXT_TOKENS=2048
